{
  "name": "@flatchat/client",
  "version": "0.0.0",
  "private": true,
  "description": "FlatChat's desktop client for Windows and Linux.",
  "license": "MPL-2.0",
  "author": "Kyonax",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/notices.mjs && node scripts/offline-worlds.ts && node scripts/make-icon.ts",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "bench": "electron-vite build && electron . --bench=10 --bench-out=out/bench.json",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:testers": "npm run build && electron-builder --linux AppImage tar.gz",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@flatchat/content": "*",
    "@flatchat/converter": "*",
    "@flatchat/effects": "*",
    "@flatchat/protocol": "*",
    "@flatchat/sim": "^0.0.0",
    "@flatchat/world-server": "*",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@webgpu/types": "^0.1.74",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "libopus-wasm": "0.4.1",
    "meshoptimizer": "1.3.0",
    "recast-navigation": "0.43.1",
    "three": "^0.186.1",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-i18n": "11.4.14",
    "vue-tsc": "^3.3.13"
  }
}
