{
  "name": "@flatchat/world-server",
  "version": "0.0.0",
  "private": true,
  "description": "FlatChat's world server: one world, run headless by its host.",
  "license": "MPL-2.0",
  "author": "Kyonax",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./net": "./src/net/index.ts",
    "./local": "./src/net/local.ts",
    "./metrics": "./src/metrics.ts",
    "./server": "./src/server.ts",
    "./content": "./src/world/content.ts",
    "./navigation": "./src/world/navigation.ts",
    "./plugins": "./src/plugins.ts",
    "./uploads": "./src/world/uploads.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@flatchat/content": "*",
    "@flatchat/protocol": "*",
    "@flatchat/sim": "*",
    "node-datachannel": "0.33.4",
    "recast-navigation": "0.43.1",
    "smol-toml": "1.9.1"
  },
  "scripts": {
    "start": "node --min-semi-space-size=16 --max-semi-space-size=16 src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
