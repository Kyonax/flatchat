{
  "name": "@flatchat/world-server",
  "version": "0.0.0",
  "private": true,
  "description": "FlatChat's world server: one world, run headless by its host.",
  "license": "MPL-2.0",
  "author": "Kyonax",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./net": "./src/net/index.ts",
    "./metrics": "./src/metrics.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@flatchat/protocol": "*",
    "node-datachannel": "0.33.4"
  },
  "scripts": {
    "start": "node --min-semi-space-size=16 --max-semi-space-size=16 src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
