{
  "name": "@flatchat/converter",
  "version": "0.0.0",
  "private": true,
  "description": "FlatChat's converter: world folders into what a world server serves, and avatar uploads into the platform's own format.",
  "license": "MPL-2.0",
  "author": "Kyonax",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./samples": "./src/avatar/samples.ts",
    "./avatar": "./src/avatar/convert.ts",
    "./item-samples": "./src/item/samples.ts",
    "./animation-samples": "./src/animation/samples.ts",
    "./format-samples": "./src/source/samples.ts",
    "./effect-samples": "./src/effect/samples.ts"
  },
  "scripts": {
    "convert": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@flatchat/content": "*",
    "@flatchat/effects": "*",
    "@flatchat/sim": "*",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "assimpjs": "0.0.10",
    "fflate": "0.8.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "jpeg-js": "0.4.4",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0",
    "recast-navigation": "0.43.1",
    "vrm-validator": "2.0.0-dev.3.10"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  }
}
